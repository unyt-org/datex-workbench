{
  "scopeName": "source.datex",
  "name": "datex",
  "fileTypes": [
    "dx"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#endpoints"
    },
    {
      "include": "#slots"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.datex"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.datex"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.datex",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.datex"
            }
          ]
        }
      ]
    },
    "constants": {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.datex"
    },
    "keywords": {
      "match": "\\b(const|let|shared|mut|function|if|else|return|print)\\b",
      "name": "keyword.control.datex"
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(?:[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)(?:f32|f64|dbig)?\\b|\\b[0-9]+(?:f32|f64|dbig)\\b",
          "name": "constant.numeric.float.datex"
        },
        {
          "match": "\\b(?:0x[0-9a-fA-F]+|0b[01]+|[0-9]+)(?:u8|u16|u32|u64|u128|ubig|i8|i16|i32|i64|i128|ibig)?\\b",
          "name": "constant.numeric.integer.datex"
        }
      ]
    },
    "endpoints": {
      "match": "@[@+]?[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.endpoint.datex"
    },
    "slots": {
      "match": "#[a-zA-Z0-9_]+",
      "name": "variable.other.slot.datex"
    },
    "functions": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": {
          "name": "entity.name.function.datex"
        }
      }
    }
  }
}